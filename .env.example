# Copy to .env before running `docker compose up`
GOOGLE_API_KEY=your_gemini_api_key_here
DB_PASSWORD=finance123
DB_NAME=finance_agent

# --- Optional: model overrides -------------------------------------------
# Free-tier request quota is enforced PER MODEL, so each role gets its own.
# Unset means the defaults in agent_service/settings.py apply. Changing these
# needs no rebuild — compose passes them through.
# PARSE_MODEL=gemini-3.5-flash-lite
# CATEGORIZE_MODEL=gemini-3.1-flash-lite
# CHAT_MODEL=gemini-3.6-flash

# --- Optional: tracing ----------------------------------------------------
# OFF unless BOTH keys are set. Transaction descriptions and amounts are
# redacted before anything is transmitted (agent_service/agent/tracing.py).
# Either LANGFUSE_BASE_URL or LANGFUSE_HOST is accepted — Langfuse's own setup
# snippet emits BASE_URL, so pasting it works as-is.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# INFO (default), or DEBUG for full tool payloads and answers
# LOG_LEVEL=INFO
