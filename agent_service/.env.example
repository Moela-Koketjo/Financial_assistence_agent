# Copy to .env for local (non-Docker) development
GOOGLE_API_KEY=your_gemini_api_key_here

# INFO (default) or DEBUG for full tool payloads and answers
LOG_LEVEL=INFO

# One model per role — the free-tier request quota is PER MODEL, so keeping
# these different gives each job its own daily budget.
PARSE_MODEL=gemini-3.5-flash-lite
CATEGORIZE_MODEL=gemini-3.1-flash-lite
CHAT_MODEL=gemini-3.6-flash

DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_agent
